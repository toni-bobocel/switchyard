---
import '../styles/global.css'

const repo = 'https://github.com/toni-bobocel/switchyard'

const quickstart = [
  '<span class="c"># point any OpenAI SDK at the gateway</span>',
  '<span class="k">curl</span> localhost:8080/v1/chat/completions \\',
  '  -H "authorization: Bearer sy_demo_support" \\',
  '  -H "x-switchyard-feature: ticket-triage" \\',
  `  -d '{"model":"auto","messages":[{"role":"user","content":"..."}]}'`,
].join('\n')

const fence = '`'.repeat(3)
const prompts = [
  {
    label: 'support / ticket-triage',
    text: 'Classify this ticket as billing, bug or other: "I was charged twice for November."',
  },
  {
    label: 'platform / code-review',
    text: 'This throws on checkout, what is wrong?',
    code: 'const total = items.reduce((a, b) => a + b.price)',
  },
  {
    label: 'platform / incident',
    text: 'Why does checkout deadlock under load? Compare the two locking designs, analyse the trade-offs and plan the migration step by step.',
  },
].map((p) => ({ ...p, input: p.code ? `${p.text}\n${fence}ts\n${p.code}\n${fence}` : p.text }))

const levers = [
  { key: 'outage', color: 'red', no: 1, label: 'Vendor down' },
  { key: 'euOnly', color: 'blue', no: 2, label: 'EU only' },
  { key: 'blockPii', color: 'yellow', no: 3, label: 'Block PII' },
  { key: 'budgetCap', color: 'black', no: 4, label: 'Budget out' },
  { key: 'rush', color: 'white', no: 5, label: 'Rush hour' },
]

const status = [
  { key: 'outage', name: 'Anthropic' },
  { key: 'euOnly', name: 'Residency' },
  { key: 'blockPii', name: 'Personal data' },
  { key: 'budgetCap', name: 'Growth budget' },
  { key: 'rush', name: 'Traffic' },
]

const adrs = [
  ['01', 'One OpenAI-compatible surface', '0001-openai-compatible-surface.md', 'adoption is a base URL'],
  ['02', 'Redact before routing, restore after', '0002-redact-before-routing.md', 'gdpr'],
  ['03', 'Heuristic routing, not a classifier model', '0003-heuristic-routing.md', 'cost'],
  ['04', 'An integer ledger on SQLite, for now', '0004-ledger-on-sqlite.md', 'finops'],
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Switchyard — every prompt passes the box</title>
    <meta
      name="description"
      content="An OpenAI-compatible LLM gateway: PII redaction, complexity routing, vendor fallback and per-team budgets."
    />
    <meta name="theme-color" content="#17211d" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="masthead">
      <span class="plate">Switchyard</span>
      <nav class="mono caps">
        <a href="#inspect">Inspect</a>
        <a href="#route">Route</a>
        <a href="#account">Account</a>
        <a href="#levers">Levers</a>
        <a href={repo}>Source ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero__top">
          <h1 class="hero__title">
            <span style="display:block;overflow:hidden"><span class="line" style="display:block">Every prompt</span></span>
            <span style="display:block;overflow:hidden"><span class="line" style="display:block">passes <span class="lit">the box.</span></span></span>
          </h1>
          <p class="hero__lede">
            <strong>An OpenAI-compatible gateway for a company's LLM traffic.</strong> Personal data is stripped before
            anything leaves, each request goes to the cheapest model that can handle it, a vendor outage becomes a
            detour, and every cent is charged to a team and a feature.
          </p>
        </div>

        <div class="panel">
          <div class="panel__screws" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <svg data-yard="hero" role="img" aria-label="Live diagram: requests from four teams pass the gateway and are routed to six models"></svg>
          <ol class="ticker" data-ticker aria-live="off"></ol>
        </div>

        <div class="hero__foot mono">
          <span>Each lamp is a thousand requests. Scroll faster, the yard gets busier.</span>
          <span>Interlocking № 7</span>
        </div>
      </section>

      <section class="chapter" id="inspect">
        <header class="chapter__head">
          <div>
            <span class="plate plate--small">Inspect</span>
            <h2 class="chapter__title">Nothing personal <em>leaves the box.</em></h2>
          </div>
          <p class="chapter__aside">
            Emails, phones, IBANs, card and social security numbers are swapped for stable tokens before a model is
            chosen. Card, IBAN and NIR are only flagged when their checksum holds. The answer is restored on the way
            out, even when a token is split across streamed chunks.
          </p>
        </header>

        <div class="inspect" data-inspect>
          <article class="ticket" data-prompt>
            <div class="ticket__head mono caps"><span>Prompt</span><span>support / refund-desk</span></div>
            <p class="ticket__body">
              Refund <span class="pii" data-kind="EMAIL" data-token="⟦EMAIL_1⟧">jeanne.martin@acme.fr</span> to
              <span class="pii" data-kind="IBAN" data-token="⟦IBAN_1⟧">FR76 3000 6000 0112 3456 7890 189</span>,
              then text her on <span class="pii" data-kind="PHONE" data-token="⟦PHONE_1⟧">06 12 34 56 78</span>.
              Card on file: <span class="pii" data-kind="CARD" data-token="⟦CARD_1⟧">4111 1111 1111 1111</span>.
            </p>
          </article>

          <div class="inspect__arrow">
            <ul class="checks mono">
              <li data-kind="EMAIL"><i></i>email · pattern</li>
              <li data-kind="IBAN"><i></i>iban · mod 97</li>
              <li data-kind="PHONE"><i></i>phone · fr plan</li>
              <li data-kind="CARD"><i></i>card · luhn</li>
            </ul>
            <button class="replay mono caps" data-replay type="button">Run again</button>
          </div>

          <article class="ticket" data-answer>
            <div class="ticket__head mono caps"><span>Answer</span><span>claude-sonnet · us</span></div>
            <p class="ticket__body">
              Done. €42.00 refunded to <span class="pii" data-token="⟦IBAN_1⟧">FR76 3000 6000 0112 3456 7890 189</span>;
              confirmation sent to <span class="pii" data-token="⟦EMAIL_1⟧">jeanne.martin@acme.fr</span> and an SMS
              queued for <span class="pii" data-token="⟦PHONE_1⟧">06 12 34 56 78</span>.
            </p>
            <span class="stamp mono caps"></span>
          </article>
        </div>
      </section>

      <section class="chapter" id="route">
        <header class="chapter__head">
          <div>
            <span class="plate plate--small">Route</span>
            <h2 class="chapter__title">The right model <em>for the job.</em></h2>
          </div>
          <p class="chapter__aside">
            No classifier model, no extra round trip: free signals scored in microseconds, every point listed in the
            <code>x-switchyard-route</code> header. This panel runs the gateway's own <code>classify()</code>.
          </p>
        </header>

        <div class="route-desk" data-route-desk>
          <div class="prompts">
            {
              prompts.map((p, i) => (
                <button
                  class="prompt"
                  type="button"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  data-text={p.input}
                >
                  <small class="mono caps">{p.label}</small>
                  <span>{p.text}</span>
                  {p.code && <code>{p.code}</code>}
                </button>
              ))
            }
          </div>

          <div class="verdict">
            <div class="panel">
              <svg class="junction yard" viewBox="0 0 640 260" aria-hidden="true">
                <path class="rail" d="M20 130 H230 L314 46 H560" />
                <path class="rail" d="M230 130 H560" />
                <path class="rail" d="M230 130 L314 214 H560" />
                <path class="route" data-route="fast" />
                <path class="route" data-route="balanced" />
                <path class="route" data-route="reasoning" />
                <text class="tier-label" x="330" y="36">FAST</text>
                <text class="tier-label" x="330" y="120">BALANCED</text>
                <text class="tier-label" x="330" y="204">REASONING</text>
                <text class="sub" x="330" y="64">mistral-small · qwen-local · haiku</text>
                <text class="sub" x="330" y="148">sonnet · mistral-large · qwen-local</text>
                <text class="sub" x="330" y="232">opus · mistral-large · qwen-local</text>
                <circle class="lamp" data-lamp="fast" cx="584" cy="46" r="8" />
                <circle class="lamp" data-lamp="balanced" cx="584" cy="130" r="8" />
                <circle class="lamp" data-lamp="reasoning" cx="584" cy="214" r="8" />
                <g class="train" style="opacity:0"><rect x="-15" y="-5" width="30" height="10" rx="5" /></g>
                <path class="blade" d="M230 127 L264 129 L264 131 L230 133Z" />
              </svg>
            </div>
            <ul class="reasons"></ul>
            <div class="score">
              <span class="mono caps">score <b data-score>0.0</b></span>
              <strong data-tier>—</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="chapter" id="account">
        <header class="chapter__head">
          <div>
            <span class="plate plate--small">Account</span>
            <h2 class="chapter__title">Every cent <em>has an owner.</em></h2>
          </div>
          <p class="chapter__aside">
            One ledger row per request, in integer micro-dollars so a month reconciles to the cent. Budgets are
            checked before the call: a team that is out gets a 402, not a surprise invoice. The board ticks with the
            demo traffic above.
          </p>
        </header>

        <div class="board">
          <div>
            <p class="mono caps" style="margin:0 0 .7rem;color:var(--cream-dim)">Month to date</p>
            <div class="flaps" data-flaps aria-live="off"></div>
          </div>
          <div class="tabs mono caps" role="tablist" data-tabs>
            <button class="tab" role="tab" type="button" data-group="team" aria-selected="true">By team</button>
            <button class="tab" role="tab" type="button" data-group="feature" aria-selected="false">By feature</button>
            <button class="tab" role="tab" type="button" data-group="model" aria-selected="false">By model</button>
          </div>
        </div>
        <div class="ledger" data-ledger></div>
      </section>

      <section class="chapter" id="levers">
        <header class="chapter__head">
          <div>
            <span class="plate plate--small">Levers</span>
            <h2 class="chapter__title">Pull a lever, <em>change the policy.</em></h2>
          </div>
          <p class="chapter__aside">
            Drag a lever or click it. The panel below and the one at the top obey: a vendor outage reroutes, EU-only
            darkens the US tracks, blocked teams are held at the gate.
          </p>
        </header>

        <div class="panel" style="margin-bottom:2rem">
          <div class="panel__screws" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <svg data-yard="desk" aria-hidden="true"></svg>
        </div>

        <div class="frame">
          <div class="levers" data-levers>
            {
              levers.map((l) => (
                <button class="lever" type="button" data-key={l.key} data-color={l.color} aria-pressed="false" aria-label={l.label}>
                  <svg viewBox="0 0 60 230" aria-hidden="true">
                    <g class="arm">
                      <rect class="shaft" x="26" y="24" width="8" height="190" rx="3" />
                      <rect x="17" y="6" width="26" height="30" rx="7" fill="#cfc7b0" stroke="#00000066" />
                      <rect x="22" y="40" width="16" height="7" rx="2" fill="#a59e89" />
                    </g>
                    <circle cx="30" cy="212" r="7" fill="#6e6a60" stroke="#00000088" />
                  </svg>
                  <span class="plate plate--small lever__no">{l.no}</span>
                  <span class="lever__label mono caps">{l.label}</span>
                </button>
              ))
            }
          </div>
          <ul class="status" data-status>
            {
              status.map((s) => (
                <li data-key={s.key}>
                  <b>{s.name}</b>
                  <span class="mono" />
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="chapter" id="timetable">
        <header class="chapter__head">
          <div>
            <span class="plate plate--small">Timetable</span>
            <h2 class="chapter__title">Decisions, <em>posted.</em></h2>
          </div>
          <p class="chapter__aside">Each architecture decision record states the context, the call, and what it costs.</p>
        </header>

        <ol class="timetable">
          {
            adrs.map(([no, title, file, tag]) => (
              <li>
                <a href={`${repo}/blob/main/docs/adr/${file}`}>
                  <span class="no mono">{no}</span>
                  <span class="title">{title}</span>
                  <span class="mono caps" style="color:var(--cream-dim)">{tag}</span>
                </a>
              </li>
            ))
          }
        </ol>

        <div class="terminal">
          <pre set:html={quickstart} />
        </div>
      </section>
    </main>

    <footer class="colophon mono caps">
      <span>Set in Archivo &amp; Fragment Mono</span>
      <span class="plate plate--small">Switchyard</span>
      <a href={repo}>github.com/toni-bobocel/switchyard</a>
    </footer>

    <script>
      import '../scripts/main.ts'
    </script>
  </body>
</html>
