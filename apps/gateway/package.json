{
  "name": "@switchyard/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "keygen": "node dist/keygen.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@switchyard/pii": "workspace:*",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
